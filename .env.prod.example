# Variables for docker-compose.prod.yml (copy to .env.prod; never commit the real file)
POSTGRES_PASSWORD=
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "import secrets; print(secrets.token_urlsafe(24))"
INGEST_API_KEY=
# Public origin of the web UI as the browser sees it (scheme + host, no path)
PUBLIC_ORIGIN=https://urpaq.example.com
SIMULATOR_MODE=embedded
ENABLE_DOCS=false
LOG_LEVEL=INFO
WEB_PORT=8080
VITE_SHOW_DEMO_ACCOUNTS=false
