# Build-time variables (only VITE_* reach the browser bundle — never put secrets here).
# Absolute API origin for production builds when the API is on another domain. Leave empty when /api is proxied on the same domain.
VITE_API_BASE=
# Hide the demo-account buttons on the login page in production builds.
VITE_SHOW_DEMO_ACCOUNTS=true
# Dev only: where `npm run dev` proxies /api (default http://127.0.0.1:8000)
# VITE_API_PROXY=http://127.0.0.1:8000
