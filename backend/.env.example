# XAVAMOS Digital Urpaq — backend configuration (copy to .env; never commit real secrets)
# Full reference: docs/DEPLOYMENT.md

# development | production | test. `production` refuses insecure defaults (see app/core/config.py).
APP_ENV=development

# SQLite for local work. Production: PostgreSQL, e.g. postgresql+psycopg://user:password@host:5432/urpaq
# If you must use SQLite in production, use an ABSOLUTE path on a persistent volume: sqlite:////data/urpaq.db
DATABASE_URL=sqlite:///./data/urpaq.db

# JWT signing key. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=480

# Comma-separated allowlist of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared key for telemetry ingest (X-Ingest-Key header: simulator runner / devices).
INGEST_API_KEY=change-me-ingest-key

# embedded = simulator loop runs inside the API process (default, single worker only)
# external = run `python -m app.simulator.runner --key <INGEST_API_KEY>` separately
# off      = no simulator (real devices / manual ingest only)
SIMULATOR_MODE=embedded
SIMULATOR_AUTOSTART=false

# Demo data with KNOWN passwords. Set to false in production and use scripts/create_admin.py.
SEED_ON_STARTUP=true

# Swagger / ReDoc at /api/docs. Automatically disabled in production unless explicitly set to true.
ENABLE_DOCS=true

# Login attempts per minute per client IP (in-process sliding window).
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Set to true only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false
# Adds X-Content-Type-Options / X-Frame-Options / Referrer-Policy / Cache-Control headers.
SECURE_HEADERS=true

# Optional: serve the built SPA from the API process (single-service deployment).
# SERVE_FRONTEND_DIR=/app/frontend/dist

LOG_LEVEL=INFO
MAX_REQUEST_BYTES=262144
